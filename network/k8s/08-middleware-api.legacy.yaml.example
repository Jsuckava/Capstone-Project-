---
# Middleware API Service Deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: middleware-api
  namespace: plv-fabric
spec:
  replicas: 3
  selector:
    matchLabels:
      app: middleware-api
      tier: application
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  template:
    metadata:
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/path: "/metrics"
        prometheus.io/port: "4000"
      labels:
        app: middleware-api
        tier: application
    spec:
      serviceAccountName: fabric-sa
      terminationGracePeriodSeconds: 45
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            podAffinityTerm:
              labelSelector:
                matchExpressions:
                - key: app
                  operator: In
                  values:
                  - middleware-api
              topologyKey: kubernetes.io/hostname
      initContainers:
      - name: wait-for-wallet-couchdb
        image: busybox:1.36.1
        imagePullPolicy: IfNotPresent
        command:
        - /bin/sh
        - -ec
        - |
          for endpoint in \
            couchdb-wallet-registrar.plv-main-campus.svc.cluster.local:5985 \
            couchdb-wallet-faculty.plv-annex-campus.svc.cluster.local:5985 \
            couchdb-wallet-department.plv-pubad-campus.svc.cluster.local:5985
          do
            host="${endpoint%:*}"
            port="${endpoint##*:}"
            echo "Waiting for ${host}:${port}..."
            until nc -w 2 "$host" "$port" </dev/null; do
              sleep 2
            done
          done
        resources:
          requests:
            cpu: 5m
            memory: 8Mi
          limits:
            cpu: 50m
            memory: 32Mi
      containers:
      - name: middleware
        image: registry.example.com/plv-repo/fabric-middleware:latest
        imagePullPolicy: Always
        workingDir: /app
        command: ["npm", "start"]
        ports:
        - containerPort: 4000
          name: api
          protocol: TCP
        envFrom:
        - secretRef:
            name: blockgo-secrets
        env:
        - name: NODE_ENV
          value: production
        - name: NODE_OPTIONS # Enforce strict memory limits for Node.js runtime
          value: "--max-old-space-size=384 --expose-gc"
        - name: PORT
          value: "4000"
        - name: GATEWAY_CACHE_MAX_USERS
          value: "500"
        - name: GATEWAY_IDLE_TIMEOUT_MS
          value: "300000"
        - name: GATEWAY_PRUNE_INTERVAL_MS
          value: "60000"
        - name: CA_CONFIG_TTL_MS
          value: "3600000"
        - name: CA_CONFIG_PRUNE_INTERVAL_MS
          value: "600000"
        - name: FABRIC_CA_CONNECTION_TIMEOUT_MS
          value: "30000"
        - name: SHUTDOWN_GRACE_MS
          value: "30000"
        - name: CSHARP_API_URL
          value: "http://client-app-service.plv-fabric.svc.cluster.local:5000"
        - name: IPFS_API_URL
          value: "/dns4/ipfs-ha-api.plv-fabric.svc.cluster.local/tcp/5001/http"
        - name: POSTGRES_DB
          value: ActivityLogs
        - name: POSTGRES_HOST
          value: postgres.plv-main-campus.svc.cluster.local
        - name: POSTGRES_PORT
          value: "5432"
        - name: CHANNEL_NAME
          value: registrar-channel
        - name: CHAINCODE_NAME
          value: registrar
        - name: FABRIC_CA_REGISTRAR_URL
          value: "https://ca-registrar.plv-main-campus.svc.cluster.local:7054"
        - name: FABRIC_CA_FACULTY_URL
          value: "https://ca-faculty.plv-annex-campus.svc.cluster.local:7054"
        - name: FABRIC_CA_DEPARTMENT_URL
          value: "https://ca-department.plv-pubad-campus.svc.cluster.local:7054"
        - name: FABRIC_CA_REGISTRAR_CERT
          value: "/etc/hyperledger/fabric-ca-roots/registrar-ca-cert.pem"
        - name: FABRIC_CA_REGISTRAR_TLS_CERT
          value: "/etc/hyperledger/fabric-ca-roots/registrar-tls-cert.pem"
        - name: FABRIC_CA_FACULTY_CERT
          value: "/etc/hyperledger/fabric-ca-roots/faculty-ca-cert.pem"
        - name: FABRIC_CA_FACULTY_TLS_CERT
          value: "/etc/hyperledger/fabric-ca-roots/faculty-tls-cert.pem"
        - name: FABRIC_CA_DEPARTMENT_CERT
          value: "/etc/hyperledger/fabric-ca-roots/department-ca-cert.pem"
        - name: FABRIC_CA_DEPARTMENT_TLS_CERT
          value: "/etc/hyperledger/fabric-ca-roots/department-tls-cert.pem"
        - name: FABRIC_CA_INSECURE_TLS
          value: "false"
        - name: ADMIN_CRYPTO_BASE
          value: "/etc/hyperledger/admin-crypto"
        - name: FABRIC_GATEWAY_TLS_ROOTS
          value: "/etc/hyperledger/fabric-gateway-tls"
        - name: CONNECTION_PROFILE_PATH
          value: "/app/connection.json"
        volumeMounts:
        - name: fabric-ca-roots
          mountPath: /etc/hyperledger/fabric-ca-roots
          readOnly: true
        - name: admin-registrar-crypto
          mountPath: /etc/hyperledger/admin-crypto/registrar
          readOnly: true
        - name: admin-faculty-crypto
          mountPath: /etc/hyperledger/admin-crypto/faculty
          readOnly: true
        - name: admin-department-crypto
          mountPath: /etc/hyperledger/admin-crypto/department
          readOnly: true
        - name: fabric-gateway-tls-roots
          mountPath: /etc/hyperledger/fabric-gateway-tls
          readOnly: true
        lifecycle:
          preStop:
            exec:
              command: ["/bin/sh", "-c", "sleep 5"]
        startupProbe:
          httpGet: # Use /api/health for startup probe
            path: /api/health 
            port: 4000
            scheme: HTTP
          periodSeconds: 5
          timeoutSeconds: 5
          failureThreshold: 60
        livenessProbe:
          httpGet:
            path: /api/health
            port: 4000
            scheme: HTTP
          initialDelaySeconds: 30
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 3
        readinessProbe:
          httpGet: # Use /api/ready for readiness probe (checks DB connectivity)
            path: /api/ready 
            port: 4000
            scheme: HTTP
          initialDelaySeconds: 10
          periodSeconds: 5
          timeoutSeconds: 3
          failureThreshold: 2
        resources:
          requests: # Set resource requests
            memory: "300Mi"
            cpu: "200m"
          limits: # Set resource limits
            memory: "512Mi"
            cpu: "500m"
      volumes:
      - name: fabric-ca-roots
        secret:
          secretName: fabric-ca-roots
      - name: admin-registrar-crypto
        secret:
          secretName: admin-registrar-crypto
      - name: admin-faculty-crypto
        secret:
          secretName: admin-faculty-crypto
      - name: admin-department-crypto
        secret:
          secretName: admin-department-crypto
      - name: fabric-gateway-tls-roots
        secret:
          secretName: fabric-gateway-tls-roots
---
apiVersion: v1
kind: Service
metadata:
  name: middleware-api
  namespace: plv-fabric
  labels:
    app: middleware-api
  annotations:
    cloud.google.com/neg: '{"ingress": true}'
spec:
  type: ClusterIP
  selector:
    app: middleware-api
  ports:
  - port: 4000
    targetPort: 4000
    protocol: TCP
    name: api
  sessionAffinity: ClientIP
  sessionAffinityConfig:
    clientIP:
      timeoutSeconds: 10800
---
apiVersion: v1
kind: Service
metadata:
  name: middleware
  namespace: plv-fabric
  labels:
    app: middleware-api
spec:
  type: ClusterIP
  selector:
    app: middleware-api
  ports:
  - port: 4000
    targetPort: 4000
    protocol: TCP
    name: api
